# Copy to .env and fill in. Never commit .env.

# RW1: X API (set a spending limit in the developer console first)
X_BEARER_TOKEN=

# RW4: Discord bot token and the channel to post to
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# HN2: Anthropic API key (set a monthly spend limit in the console first)
ANTHROPIC_API_KEY=

# JR2: Gmail API. Keep the OAuth client file and token outside the repo, or under data/private/.
GMAIL_OAUTH_CLIENT_FILE=
GMAIL_TOKEN_FILE=

# JR12: hosted database
DATABASE_URL=
